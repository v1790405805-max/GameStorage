  hpText: {fileID: 0}
  defaultTitle: "\u6DF1\u6E0A\u8D2A\u5A6A\u7684\u5951\u7EA6"
  initialStory: "\u4F60\u7A7F\u8FC7\u788E\u77F3\u5D99\u5CCB\u7684\u88C2\u8C37\uFF0C\u524D\u65B9\u7684\u77F3\u58C1\u4E0B\u8737\u7F29\u7740\u4E00\u4F4D\u62AB\u7740\u7834\u65E7\u515C\u5E3D\u7684\u884C\u5546\u3002\n\u4ED6\u9762\u524D\u6446\u653E\u7740\u4E00\u76CF\u5E7D\u7EFF\u8272\u7684\u5929\u5E73\uFF0C\u5929\u5E73\u4E00\u7AEF\u662F\u53EE\u5F53\u4F5C\u54CD\u7684\u6676\u77F3\uFF0C\u53E6\u4E00\u7AEF\u5219\u662F\u4E00\u5177\u67AF\u7AED\u7684\u5FC3\u810F\u5BB9\u5668\u3002\n\n\u300C\u65C5\u4EBA\uFF0C\u4E16\u95F4\u4E07\u7269\u7686\u6709\u5B9A\u4EF7\u3002\u732E\u51FA\u4F60\u7684\u751F\u547D\u529B\uFF0C\u6211\u4FBF\u7ED9\u4F60\u5E26\u53BB\u8D22\u5BCC\u2026\u2026\u300D\u4ED6\u6C99\u54D1\u5730\u4F4E\u8BED\u9053\u3002"
  optionSlots:
  - button: {fileID: 24503213}
    titleText: {fileID: 447699241}
    detailText: {fileID: 1360660181}
  - button: {fileID: 40622229}
    titleText: {fileID: 1669876919}
    detailText: {fileID: 934673702}
  - button: {fileID: 2112555729}
    titleText: {fileID: 886838971}
    detailText: {fileID: 1139883196}
  leaveButton: {fileID: 143532336}
  mapSceneName: 1_Map_Scene
  choices:
  - optionTitle: "\u62FE\u53D6\u788E\u5C51"
    optionDetail: "\u4ECE\u5730\u4E0A\u6361\u8D70\u6563\u843D\u7684\u6676\u77F3 (+10
      \u6676\u77F3)"
    maxHPCost: 0
    goldReward: 10
    resultStoryText: "\u4F60\u6CA1\u6709\u7406\u4F1A\u5546\u4EBA\u5145\u6EE1\u8BF1\u60D1\u7684\u4F4E\u8BED\uFF0C\u53EA\u662F\u5F2F\u8170\u6361\u8D77\u4E86\u6563\u843D\u5728\u5730\u4E0A\u7684\u51E0\u5757\u788E\u6676\u77F3\u3002\u5546\u4EBA\u53D1\u51FA\u4E00\u58F0\u4E0D\u5C51\u7684\u55E4\u7B11\uFF0C\u7F13\u7F13\u9690\u5165\u9634\u5F71\u4E2D\u2026\u2026"
  - optionTitle: "\u8F7B\u89E6\u5929\u5E73"
    optionDetail: "\u732E\u51FA\u90E8\u5206\u751F\u673A (-10 \u751F\u547D\u4E0A\u9650\uFF0C+50
      \u6676\u77F3)"
    maxHPCost: 10
