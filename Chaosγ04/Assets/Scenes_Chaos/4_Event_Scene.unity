    resultStoryText: "\u4F60\u5C06\u624B\u638C\u6309\u5728\u5929\u5E73\u4E0A\uFF0C\u4E00\u80A1\u51B0\u51C9\u7684\u62BD\u79BB\u611F\u5212\u8FC7\u56DB\u80A2\u3002\u4E00\u888B\u6C89\u7538\u7538\u7684\u6676\u77F3\u843D\u5165\u4F60\u7684\u6000\u4E2D\uFF0C\u4F60\u7684\u811A\u6B65\u6C89\u91CD\u4E86\u51E0\u5206\uFF0C\u4F46\u94B1\u5305\u5145\u5B9E\u4E86\u3002"
  - optionTitle: "\u51DD\u89C6\u6DF1\u6E0A"
